---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import SmoothScroll from '../components/SmoothScroll.tsx';
import Splash from '../components/Splash.astro';
import { profile } from '../data/profile';
import { heroSocials } from '../data/social';
import { services } from '../data/services';

interface Props {
	title?: string;
	description?: string;
	lang?: 'en' | 'id';
}

const {
	title = 'Portofolio Pribadi',
	description = 'Web portofolio modern dengan animasi',
	lang = 'en'
} = Astro.props;

const isId = lang === 'id';

const site = new URL(Astro.site ?? 'https://lana-jauhar.vercel.app');
const siteUrl = site.toString();
const idUrl = new URL('/id/', site).toString();
const ogImage = new URL('/og-image.jpg', site).toString();
const canonicalUrl = isId ? idUrl : siteUrl;

// Optimized profile photo for structured data (Schema.org Person.image)
const profileImage = await getImage({ src: profile.photo, width: 512, format: 'webp' });
const profileImageUrl = new URL(profileImage.src, site).toString();

// Social profile URLs for Schema.org sameAs (mailto: links are excluded)
const sameAs = [
	'https://github.com/lana-jo',
	...heroSocials
		.filter((s) => s.href.startsWith('http'))
		.map((s) => s.href)
].filter((url, i, arr) => arr.indexOf(url) === i);

	const serviceName = isId
		? 'Jasa Pembuatan Website, Aplikasi & Mobile App, Joki Tugas IT, Joki Coding'
		: 'Website, Web App & Mobile App Development, IT Assignment Help, Coding Assistance';

	const serviceDescription = isId
		? 'Jasa pembuatan website, aplikasi web, webapp, aplikasi mobile, backend API, jasa IT dan jaringan, joki tugas IT, joki coding, freelancer IT dan konsultasi teknologi.'
		: 'Website, web app, webapp, mobile app, backend API, IT & network services, joki tugas IT, joki coding, and freelance tech consulting.';

	const faq = isId
		? [
				{
					'@type': 'Question',
					name: 'Apakah menerima jasa pembuatan website?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Ya, kami menerima jasa pembuatan website company profile, toko online, landing page, dan website personal dengan framework modern.'
					}
				},
				{
					'@type': 'Question',
					name: 'Apakah menerima jasa pembuatan aplikasi dan webapp?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Ya, menerima jasa pembuatan aplikasi web dan webapp seperti sistem POS, inventory, perpustakaan, dan sistem informasi manajemen bisnis.'
					}
				},
				{
					'@type': 'Question',
					name: 'Apakah menerima jasa pembuatan aplikasi mobile?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Ya, menerima jasa pembuatan aplikasi mobile Android dengan Kotlin & Jetpack Compose, serta aplikasi cross-platform dengan Flutter.'
					}
				},
				{
					'@type': 'Question',
					name: 'Apakah menerima joki tugas IT?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Ya, kami menerima joki tugas IT untuk mahasiswa — tugas jaringan, database, pemrograman, dan desain sistem dikerjakan oleh developer berpengalaman.'
					}
				},
				{
					'@type': 'Question',
					name: 'Apakah menerima joki coding?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Ya, kami menerima joki coding untuk mahasiswa dan profesional — pengembangan web, aplikasi, integrasi API, dan perbaikan bug dikerjakan oleh developer ahli.'
					}
				},
				{
					'@type': 'Question',
					name: 'Bagaimana cara memesan jasa atau konsultasi?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Hubungi kami melalui WhatsApp, Telegram, atau email yang tertera di halaman kontak untuk konsultasi gratis.'
					}
				}
			]
		: [
				{
					'@type': 'Question',
					name: 'Do you accept website development services?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Yes, we accept website development for company profiles, online stores, landing pages, and personal websites built with modern frameworks.'
					}
				},
				{
					'@type': 'Question',
					name: 'Do you accept web app and webapp development?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Yes, we build web apps and webapps such as POS systems, inventory, libraries, and business management systems.'
					}
				},
				{
					'@type': 'Question',
					name: 'Do you accept mobile app development?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Yes, we build native Android apps with Kotlin & Jetpack Compose, and cross-platform apps with Flutter.'
					}
				},
				{
					'@type': 'Question',
					name: 'Do you accept IT assignment help (joki tugas IT)?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Yes, we accept IT assignment help for students — networking, database, programming, and system design tasks handled by experienced developers.'
					}
				},
				{
					'@type': 'Question',
					name: 'Do you accept coding assistance (joki coding)?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Yes, we accept coding assistance for students and professionals — web development, app development, API integration, and bug fixing by expert developers.'
					}
				},
				{
					'@type': 'Question',
					name: 'How can I order services or get a consultation?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: 'Contact us via WhatsApp, Telegram, or the email listed on the contact page for a free consultation.'
					}
				}
			];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}#website`,
			url: siteUrl,
			name: profile.name,
			description,
			inLanguage: lang,
			publisher: { '@id': `${siteUrl}#person` }
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl}#person`,
			name: profile.name,
			jobTitle: ['Software Developer', 'Software Engineer'],
			description: isId ? profile.descriptionId : profile.description,
			url: siteUrl,
			image: profileImageUrl,
			sameAs
		},
		{
			'@type': 'Service',
			'@id': `${siteUrl}#service`,
			name: serviceName,
			serviceType:
				'Software Developer, Software Engineer, Jasa Pembuatan Website, Jasa Pembuatan Aplikasi, Jasa Pembuatan Aplikasi Mobile, Joki Tugas IT, Joki Coding',
			description: serviceDescription,
			provider: { '@id': `${siteUrl}#person` },
			areaServed: 'Indonesia',
			availableChannel: {
				'@type': 'ServiceChannel',
				serviceUrl: `${siteUrl}#contact`,
				availableLanguage: ['id', 'en']
			},
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: isId ? 'Layanan Jasa IT' : 'IT Services',
				itemListElement: services.map((s) => ({
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: isId ? s.titleId : s.title,
						description: isId ? s.descriptionId : s.description
					}
				}))
			}
		},
		{
			'@type': 'FAQPage',
			'@id': `${siteUrl}#faq`,
			mainEntity: faq
		}
	]
};
---
<!doctype html>
<html lang={lang}>
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={description} />
	<meta
		name="keywords"
		content={isId
			? 'jasa pembuatan website, jasa pembuatan aplikasi, jasa pembuatan aplikasi dan website, jasa pembuatan aplikasi dan webapp, jasa pembuatan mobile, jasa pembuatan aplikasi mobile, jasa IT, freelancer IT, software developer Indonesia, software engineer Indonesia, web developer, jasa programmer, jasa programmer Indonesia, programmer Indonesia, pembuatan website murah, joki tugas IT, joki coding, jasa joki tugas, jasa joki coding, bantu tugas IT, bantu coding'
			: 'website development services, web app development, mobile app development, android developer, flutter developer, software developer Indonesia, software engineer, freelance web developer, custom software development, IT services, joki tugas IT, joki coding, IT assignment help, coding assistance, homework help developer'}
		/>
	<meta name="robots" content="index, follow" />
	<meta name="author" content={profile.name} />
	<link rel="canonical" href={canonicalUrl} />
	<link rel="alternate" hreflang="en" href={siteUrl} />
	<link rel="alternate" hreflang="id" href={idUrl} />
	<link rel="alternate" hreflang="x-default" href={siteUrl} />
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content={profile.name} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:image:secure_url" content={ogImage} />
	<meta property="og:image:type" content="image/jpeg" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content={isId ? 'Portofolio Lana Jauhar' : 'Lana Jauhar Portfolio'} />
	<meta property="og:locale" content={isId ? 'id_ID' : 'en_US'} />
	<meta property="og:locale:alternate" content={isId ? 'en_US' : 'id_ID'} />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />
	<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
	<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
	<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
	<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
	<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	<title>{title}</title>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</head>
<body>

	<Splash name={profile.name} />

	<SmoothScroll client:load>
		<slot />
	</SmoothScroll>

	<ClientRouter />
</body>
</html>
