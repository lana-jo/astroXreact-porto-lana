---
import { techStacks } from '../data/techStacks';
import Bi from './Bi.astro';

interface Props {
	lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
---

<section id="techstack" class="fade-up card reveal delay-2">
	<div class="porto-header">
		<div>
			<h2><Bi en="Tech Stack" id="Tech Stack" lang={lang} /></h2>
			<span class="section-subtitle"><Bi en="Core Technologies & Frameworks" id="Teknologi & Framework Inti" lang={lang} /></span>
		</div>
	</div>
	<div class="chips">
		{techStacks.map((stack) => (
			<span class="chip" title={stack.name}>
				<img
					src={`https://cdn.simpleicons.org/${stack.icon}/${stack.color}`}
					alt={`${stack.name} logo`}
					width="16"
					height="16"
					loading="lazy"
				/>
				{stack.name}
			</span>
		))}
	</div>
</section>
