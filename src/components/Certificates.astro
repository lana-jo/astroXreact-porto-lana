---
import { Image, getImage } from 'astro:assets';
import { certificates } from '../data/certificates';
import Bi from './Bi.astro';

interface Props {
	lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;

const certificateItems = await Promise.all(
	certificates.map(async (item) => {
		const photos = Array.isArray(item.photo) ? item.photo : [item.photo];
		// Build the lightbox gallery from optimized images instead of full-resolution originals
		const gallery =
			photos.length > 1
				? JSON.stringify(
						await Promise.all(
							photos.map(async (photo) => {
								const optimized = await getImage({ src: photo, width: 1200, format: 'webp' });
								return optimized.src;
							})
						)
					)
				: undefined;
		return { item, photos, gallery };
	})
);
---

<section id="certif" class="fade-up card delay-3">
	<div class="porto-header">
		<div>
			<h2><Bi en="Certificates & Licenses" id="Sertifikat & Lisensi" lang={lang} /></h2>
			<span class="section-subtitle"><Bi en={`${certificates.length} Verified Certificates`} id={`${certificates.length} Sertifikat Terverifikasi`} lang={lang} /></span>
		</div>
	</div>
	<div class="certificates-grid">
		{certificateItems.map(({ item, photos, gallery }) => (
			<article class="certificate-item">
				<div class="cert-header">
					<h3>{item.name}</h3>
					{photos.length > 1 && (
						<span class="page-badge"><Bi en={`${photos.length} Photos`} id={`${photos.length} Foto`} lang={lang} /></span>
					)}
				</div>
					<div class="cert-image-wrapper" data-title={item.name} data-gallery={gallery}>
						<Image src={photos[0]} alt={item.name} class="cert-image" />
							<div class="image-overlay">
								<span class="zoom-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline;vertical-align:middle;margin-right:4px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><Bi en="View Certificate" id="Lihat Sertifikat" lang={lang} /></span>
							</div>
						</div>
						<div style="margin-top: 10px; text-align: right;">
							<button class="porto-btn secondary-btn download-cert-btn" data-img={photos[0].src} data-name={item.name} style="font-size: 0.85rem; padding: 6px 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> <Bi en="Download PDF" id="Unduh PDF" lang={lang} />
							</button>
						</div>
				</article>
			))}
		</div>
	</section>

	<script>
		document.querySelectorAll('.download-cert-btn').forEach((btn) => {
			btn.addEventListener('click', async (e) => {
				e.stopPropagation();
				const imgUrl = btn.getAttribute('data-img');
				const certName = btn.getAttribute('data-name') || 'certificate';
				console.log('Cert imgUrl:', imgUrl);
				if (!imgUrl) return;

				try {
					const { jsPDF } = (window as any).jspdf;
					const doc = new jsPDF({
						orientation: 'landscape',
						unit: 'px',
						format: 'a4'
					});

					const img = new Image();
					// img.crossOrigin = 'Anonymous';
					img.src = imgUrl;
					await new Promise((resolve, reject) => {
						img.onload = resolve;
						img.onerror = (err) => {
							console.error('Cert image load error:', err);
							reject(err);
						};
					});

					const pageWidth = doc.internal.pageSize.getWidth();
					const pageHeight = doc.internal.pageSize.getHeight();
					
					// Calculate aspect ratio
					const imgRatio = img.width / img.height;
					let w = pageWidth - 40;
					let h = w / imgRatio;
					if (h > pageHeight - 40) {
						h = pageHeight - 40;
						w = h * imgRatio;
					}

					const x = (pageWidth - w) / 2;
					const y = (pageHeight - h) / 2;

					doc.addImage(img, 'JPEG', x, y, w, h);
					doc.save(`${certName.toLowerCase().replace(/\s+/g, '-')}.pdf`);
				} catch (err) {
					console.error('Failed to generate PDF', err);
					alert('Gagal mendownload PDF sertifikat: ' + err);
				}
			});
		});
	</script>
