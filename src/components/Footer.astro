---
import { heroSocials } from '../data/social';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-content">
		<p class="footer-copyright">&copy; {year} Lana Jauhar. All rights reserved.</p>
		<div class="footer-social">
			{heroSocials.map((social) => (
				<a href={social.href} target="_blank" rel="noopener" class="social-icon-btn" aria-label={social.label}>
					<img src={social.icon} alt="" aria-hidden="true" />
				</a>
			))}
		</div>
	</div>
</footer>
