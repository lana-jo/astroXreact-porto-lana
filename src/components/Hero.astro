---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import { heroSocials } from '../data/social';
import Bi from './Bi.astro';

interface Props {
	lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
---

<header id="home" class="fade-up hero card reveal delay-1">
	<div>
		<span class="hero-badge"><Bi en="Website, App & Mobile Development Services" id="Jasa Pembuatan Website, Aplikasi, & Mobile App" lang={lang} /></span>
		<h1><Bi en={profile.title} id={profile.titleId} lang={lang} /></h1>
		<p class="description"><Bi en={profile.description} id={profile.descriptionId} lang={lang} /></p>
		<div class="hero-actions">
			<a href="#project" class="porto-btn primary-btn"><Bi en="View Projects" id="Lihat Proyek" lang={lang} /></a>
			<a href="https://github.com/lana-jo" target="_blank" rel="noopener" class="porto-btn secondary-btn">GitHub</a>
		</div>
		<div class="social-buttons">
			{heroSocials.map((social) => (
				<a href={social.href} target="_blank" rel="noopener" class="social-icon-btn" title={social.label} aria-label={social.label}>
					<img src={social.icon} alt={social.label} loading="lazy" />
				</a>
			))}
		</div>
	</div>
	<Image class="profile-photo" src={profile.photo} alt={profile.name} width={461} height={661} loading="lazy" />
</header>
