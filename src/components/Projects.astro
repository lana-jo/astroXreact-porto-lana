---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import Bi from './Bi.astro';
---

<section id="project" class="fade-up card reveal delay-4">
	<div class="porto-header">
		<div>
			<h2><Bi en="Featured Projects" id="Proyek Unggulan" /></h2>
			<span class="section-subtitle"><Bi en={`${projects.length} Projects Built`} id={`${projects.length} Proyek Dibuat`} /></span>
		</div>
		<a href="https://github.com/lana-jo" target="_blank" rel="noopener" class="view-all-btn">
			<Bi en="View All on GitHub ↗" id="Lihat Semua di GitHub ↗" />
		</a>
	</div>
	<div class="projects">
		{projects.map((item) => {
			const tags = item.stack.split(',').map((s) => s.trim()).filter(Boolean);
			return (
				<article class="project-item">
					{item.img && (
						<div class="project-image-wrapper" data-title={item.title}>
							<Image src={item.img} alt={item.title} class="project-image" />
							<div class="image-overlay">
								<span class="zoom-icon">🔍 <Bi en="View Screenshot" id="Lihat Tangkapan Layar" /></span>
							</div>
						</div>
					)}
					<div class="project-info">
						<h3><Bi en={item.title} id={item.titleId} /></h3>
						<p><Bi en={item.detail} id={item.detailId} /></p>
						<div class="project-tags">
							{tags.map((tag) => (
								<span class="project-tag">{tag}</span>
							))}
						</div>
						<div class="project-actions">
							{item.github && (
								<a href={item.github} target="_blank" rel="noopener" class="porto-btn secondary-btn">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
									</svg>
									GitHub
								</a>
							)}
							{item.live && (
								<a href={item.live} target="_blank" rel="noopener" class="porto-btn live-btn">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<circle cx="12" cy="12" r="10" />
										<line x1="2" y1="12" x2="22" y2="12" />
										<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
									</svg>
									<Bi en="Live Demo" id="Demo Langsung" />
								</a>
							)}
						</div>
					</div>
				</article>
			);
		})}
	</div>
</section>
