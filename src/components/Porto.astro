---
import Navbar from './Navbar';
import Hero from './Hero.astro';
import Timeline from './Timeline.astro';
import Services from './Services.astro';
import TechStack from './TechStack.astro';
import Projects from './Projects.astro';
import Certificates from './Certificates.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Lightbox from './Lightbox.astro';
import { organizations } from '../data/organizations';
import { experiences } from '../data/experiences';

interface Props {
	lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
---

<main id="main-content" class="portofolio">
	<Navbar client:load lang={lang} />

	<Hero lang={lang} />
	<Services lang={lang} />
	<Timeline title="Organization" titleId="Organisasi" id="organization" entries={organizations} lang={lang} />
	<Timeline title="Experience" titleId="Pengalaman" id="experience" entries={experiences} lang={lang} />
	<TechStack lang={lang} />
	<Projects lang={lang} />
	<Certificates lang={lang} />
	<Contact lang={lang} />
	<Lightbox />
</main>

<Footer lang={lang} />

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	document.addEventListener('astro:page-load', () => {
		const reveals = document.querySelectorAll('.reveal');
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) entry.target.classList.add('active');
				});
			},
			{ threshold: 0.2 }
		);
		reveals.forEach((el) => observer.observe(el));

		gsap.utils.toArray<HTMLElement>('.fade-up').forEach((el) => {
			gsap.fromTo(
				el,
				{ opacity: 0, y: 20 },
				{
					opacity: 1,
					y: 0,
					duration: 0.25,
					ease: 'power2.out',
					scrollTrigger: { trigger: el, start: 'top 92%', toggleActions: 'play none none reverse' }
				}
			);
		});
	});
</script>


