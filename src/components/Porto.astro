---
import Navbar from './Navbar';
import Hero from './Hero.astro';
import Timeline from './Timeline.astro';
import Services from './Services.astro';
import TechStack from './TechStack.astro';
import Projects from './Projects.astro';
import Certificates from './Certificates.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Lightbox from './Lightbox.astro';
import { organizations } from '../data/organizations';
import { experiences } from '../data/experiences';

interface Props {
	lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
---

<main id="main-content" class="portofolio">
	<Navbar client:load lang={lang} />

	<Hero lang={lang} />
	<Services lang={lang} />
	<TechStack lang={lang} />
	<Projects lang={lang} />
	<Timeline title="Experience" titleId="Pengalaman" id="experience" entries={experiences} lang={lang} />
	<Timeline title="Organization" titleId="Organisasi" id="organization" entries={organizations} lang={lang} />
	<Certificates lang={lang} />
	<Contact lang={lang} />
	<Lightbox />
</main>

<Footer lang={lang} />

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	document.addEventListener('astro:page-load', () => {
		ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

		const DELAY_MAP: Record<string, number> = {
			'delay-1': 0,
			'delay-2': 0.1,
			'delay-3': 0.2,
			'delay-4': 0.3
		};

		gsap.utils.toArray<HTMLElement>('.fade-up').forEach((el) => {
			const delay =
				DELAY_MAP[[...el.classList].find((c) => c.startsWith('delay-')) ?? ''] ?? 0;

			gsap.fromTo(
				el,
				{ opacity: 0, y: 20 },
				{
					opacity: 1,
					y: 0,
					duration: 0.4,
					delay,
					ease: 'power2.out',
					scrollTrigger: {
						trigger: el,
						start: 'top 92%',
						toggleActions: 'play none none reverse'
					}
				}
			);
		});

		ScrollTrigger.refresh();
	});
</script>


