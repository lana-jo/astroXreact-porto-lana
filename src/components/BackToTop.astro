---
// Floating back-to-top rocket button. Hidden until the user scrolls down,
// launches upward with a flame trail when clicked.
---

<button id="back-to-top" class="back-to-top" type="button" aria-label="Back to top">
	<span class="back-to-top__rocket">
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
			<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
			<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
			<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
		</svg>
		<span class="back-to-top__flame" aria-hidden="true"></span>
	</span>
</button>

<script>
	const btn = document.getElementById('back-to-top');
	if (btn) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const getScrollY = () => {
			return window.lenis?.scroll ?? window.scrollY ?? document.documentElement.scrollTop;
		};

		const scrollToTop = () => {
			if (window.lenis && typeof window.lenis.scrollTo === 'function') {
				window.lenis.scrollTo(0, {
					force: true,
					...(reducedMotion.matches ? { duration: 0 } : {})
				});
			} else {
				window.scrollTo({
					top: 0,
					behavior: reducedMotion.matches ? 'auto' : 'smooth'
				});
			}
		};

		const onScroll = () => {
			const y = getScrollY();
			btn.classList.toggle('visible', y > 600);
			if (y <= 0 && btn.classList.contains('launching')) {
				btn.classList.remove('launching');
			}
		};

		btn.addEventListener('click', () => {
			if (btn.classList.contains('launching')) return;
			btn.classList.add('launching');
			scrollToTop();
		});

		btn.addEventListener('animationend', () => {
			btn.classList.remove('launching');
		}, { once: true });

		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}
</script>
