---
import type { TimelineEntry } from '../data/types';

interface Props {
	title: string;
	id: string;
	entries: TimelineEntry[];
}

const { title, id, entries } = Astro.props;
---

<section {id} class="fade-up card reveal delay-2">
	<div class="porto-header">
		<div>
			<h2>{title}</h2>
		</div>
	</div>
	<div class="timeline">
		{entries.map((item) => (
			<div class="timeline-item">
				<div class="timeline-content">
					<div class="timeline-header">
						<div>
							<h3>{item.role}</h3>
							<h4 class="company-name">{item.company}</h4>
						</div>
						<span class="period-badge">{item.period}</span>
					</div>
					<ul class="timeline-list">
						{item.descriptions.map((desc) => <li>{desc}</li>)}
					</ul>
				</div>
			</div>
		))}
	</div>
</section>

