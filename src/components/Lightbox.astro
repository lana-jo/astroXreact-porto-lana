---
// Lightbox markup + behavior for project and certificate images.
---
<div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Image preview" tabindex="-1">
	<button class="lightbox-close" aria-label="Close">&times;</button>
	<div class="lightbox-stage">
		<button id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Previous image" type="button">&#10094;</button>
		<div class="lightbox-content">
			<img id="lightbox-img" src="" alt="" />
			<div class="lightbox-meta">
				<p id="lightbox-title"></p>
				<span id="lightbox-counter"></span>
			</div>
			<div id="lightbox-dots" class="lightbox-dots"></div>
		</div>
		<button id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Next image" type="button">&#10095;</button>
	</div>
</div>

<script>
	const modal = document.getElementById('lightbox-modal');
	const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
	const modalTitle = document.getElementById('lightbox-title');
	const modalCounter = document.getElementById('lightbox-counter');
	const dotsContainer = document.getElementById('lightbox-dots');
	const closeBtn = document.querySelector('.lightbox-close');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');
	let lastFocusedElement: HTMLElement | null = null;
	let gallery: string[] = [];
	let galleryIndex = 0;
	let galleryTitle = '';
	let pendingSrc: string | null = null;

	const getFocusableElements = () => {
		if (!modal) return [];
		return modal.querySelectorAll<HTMLElement>('button, [tabindex]:not([tabindex="-1"])');
	};

	const trapFocus = (e: KeyboardEvent) => {
		if (e.key !== 'Tab' || !modal?.classList.contains('active')) return;
		const focusable = getFocusableElements();
		if (focusable.length === 0) return;
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (e.shiftKey) {
			if (document.activeElement === first) {
				e.preventDefault();
				last.focus();
			}
		} else {
			if (document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}
	};

	const renderDots = () => {
		if (!dotsContainer) return;
		dotsContainer.innerHTML = '';
		gallery.forEach((_, i) => {
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.className = 'lightbox-dot';
			dot.setAttribute('aria-label', `Go to image ${i + 1}`);
			dot.addEventListener('click', () => {
				galleryIndex = i;
				renderImage();
			});
			dotsContainer.appendChild(dot);
		});
		updateDots();
	};

	const updateDots = () => {
		if (!dotsContainer) return;
		const dots = dotsContainer.querySelectorAll<HTMLElement>('.lightbox-dot');
		dots.forEach((dot, i) => dot.classList.toggle('active', i === galleryIndex));
	};

	const renderImage = () => {
		if (!modalImg || !modalCounter || !prevBtn || !nextBtn) return;
		const src = gallery[galleryIndex];
		const loader = new Image();
		loader.onload = () => {
			if (pendingSrc === src) modalImg.src = src;
		};
		pendingSrc = src;
		loader.src = src;
		modalImg.alt = galleryTitle || '';
		if (gallery.length > 1) {
			modalCounter.textContent = `${galleryIndex + 1} / ${gallery.length}`;
			prevBtn.style.display = '';
			nextBtn.style.display = '';
			if (dotsContainer) dotsContainer.style.display = '';
		} else {
			modalCounter.textContent = '';
			prevBtn.style.display = 'none';
			nextBtn.style.display = 'none';
			if (dotsContainer) dotsContainer.style.display = 'none';
		}
		updateDots();
	};

	const preloadGallery = () => {
		gallery.forEach((src) => {
			const img = new Image();
			img.src = src;
		});
	};

	const openModal = (wrapper: HTMLElement) => {
		const raw = wrapper.getAttribute('data-gallery');
		lastFocusedElement = document.activeElement as HTMLElement;
		galleryTitle = wrapper.getAttribute('data-title') || '';
		if (raw) {
			try {
				gallery = JSON.parse(raw);
			} catch {
				gallery = [];
			}
		} else {
			const img = wrapper.querySelector('img');
			gallery = img ? [img.src] : [];
		}
		galleryIndex = 0;
		preloadGallery();
		renderDots();
		if (gallery.length > 0 && modal && modalImg && modalTitle) {
			modalTitle.textContent = galleryTitle;
			renderImage();
			modal.classList.add('active');
			document.body.style.overflow = 'hidden';
			modal.focus();
		}
	};

	const closeModal = () => {
		if (modal) {
			modal.classList.remove('active');
			document.body.style.overflow = '';
			if (modalImg) {
				// Defer clearing the src until the fade-out transition finishes,
				// so the photo stays visible while the modal fades closed.
				setTimeout(() => {
					if (!modal.classList.contains('active')) modalImg.src = '';
				}, 250);
			}
			if (lastFocusedElement) {
				lastFocusedElement.focus();
				lastFocusedElement = null;
			}
		}
	};

	const navigate = (dir: number) => {
		if (gallery.length < 2) return;
		galleryIndex = (galleryIndex + dir + gallery.length) % gallery.length;
		renderImage();
	};

	const init = () => {
		const wrappers = document.querySelectorAll<HTMLElement>('.project-image-wrapper, .cert-image-wrapper');
		wrappers.forEach((wrapper) => {
			if (!wrapper.dataset.lightboxBound) {
				wrapper.addEventListener('click', () => openModal(wrapper));
				wrapper.dataset.lightboxBound = 'true';
			}
		});
		const galleryBtns = document.querySelectorAll<HTMLElement>('.gallery-btn');
		galleryBtns.forEach((btn) => {
			if (!btn.dataset.lightboxBound) {
				btn.addEventListener('click', () => openModal(btn));
				btn.dataset.lightboxBound = 'true';
			}
		});
	};

	closeBtn?.addEventListener('click', closeModal);
	prevBtn?.addEventListener('click', () => navigate(-1));
	nextBtn?.addEventListener('click', () => navigate(1));
	modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeModal();
		if (modal?.classList.contains('active') && e.key === 'ArrowLeft') navigate(-1);
		if (modal?.classList.contains('active') && e.key === 'ArrowRight') navigate(1);
		trapFocus(e);
	});

	init();
	document.addEventListener('astro:page-load', init);
</script>
